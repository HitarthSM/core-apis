<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
      background: #fff;
      color: #1f2937;
      font-size: 13px;
      line-height: 1.5;
    }
    .page { padding: 36px 40px; max-width: 800px; margin: 0 auto; }

    /* ── Header ── */
    .header {
      display: flex; justify-content: space-between; align-items: flex-start;
      margin-bottom: 28px; padding-bottom: 20px;
      border-bottom: 3px solid #0d9488;
    }
    .brand h1 { font-size: 24px; font-weight: 800; color: #0d9488; margin-bottom: 2px; }
    .brand p  { font-size: 12px; color: #6b7280; line-height: 1.6; }
    .doc-meta { text-align: right; }
    .doc-meta .doc-type {
      font-size: 26px; font-weight: 800; color: #111827;
      text-transform: uppercase; letter-spacing: 2px;
    }
    .doc-meta .po-number { font-size: 14px; color: #6b7280; margin-top: 4px; }
    .doc-meta .status-chip {
      display: inline-block; margin-top: 6px;
      padding: 3px 12px; border-radius: 20px;
      font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px;
    }
    .status-Draft        { background: #f3f4f6; color: #6b7280; }
    .status-Submitted    { background: #dbeafe; color: #1e3a8a; }
    .status-Received     { background: #d1fae5; color: #065f46; }
    .status-Allocated    { background: #d1fae5; color: #065f46; }
    .status-PartiallyReceived { background: #fef3c7; color: #92400e; }
    .status-Cancelled    { background: #fee2e2; color: #7f1d1d; }

    /* ── Party Cards ── */
    .party-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px; }
    .party-card { border: 1px solid #e5e7eb; border-radius: 8px; padding: 14px 16px; }
    .party-card .party-label {
      font-size: 10px; text-transform: uppercase; letter-spacing: 0.8px;
      color: #9ca3af; font-weight: 700; margin-bottom: 8px;
      padding-bottom: 6px; border-bottom: 1px solid #f3f4f6;
    }
    .party-card .party-name { font-size: 14px; font-weight: 700; color: #111827; margin-bottom: 4px; }
    .party-card .party-row  { font-size: 12px; color: #6b7280; display: flex; gap: 6px; }
    .party-card .party-row strong { color: #374151; }

    /* ── Meta Strip ── */
    .meta-strip {
      display: flex; gap: 24px; background: #f0fdfa; border: 1px solid #99f6e4;
      border-radius: 8px; padding: 12px 16px; margin-bottom: 24px;
    }
    .meta-item { flex: 1; }
    .meta-item .meta-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.6px; color: #0d9488; font-weight: 700; margin-bottom: 3px; }
    .meta-item .meta-value { font-size: 13px; font-weight: 600; color: #111827; }

    /* ── Items Table ── */
    table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
    thead tr { background: #0d9488; }
    thead th {
      padding: 10px 12px; text-align: left;
      font-size: 11px; text-transform: uppercase; letter-spacing: 0.6px;
      color: #fff; font-weight: 600;
    }
    thead th:not(:first-child) { text-align: right; }
    tbody tr:nth-child(even) { background: #f9fafb; }
    tbody td { padding: 10px 12px; border-bottom: 1px solid #f3f4f6; font-size: 13px; color: #374151; }
    tbody td:not(:first-child) { text-align: right; }
    .item-name { font-weight: 600; color: #111827; }
    .item-sku  { font-size: 11px; color: #9ca3af; }

    /* ── Totals ── */
    .totals-wrap { display: flex; justify-content: flex-end; margin-bottom: 28px; }
    .totals { width: 260px; }
    .totals-row { display: flex; justify-content: space-between; padding: 7px 0; font-size: 13px; color: #6b7280; border-bottom: 1px dashed #e5e7eb; }
    .totals-row:last-child { border-bottom: none; padding-top: 12px; font-size: 16px; font-weight: 800; color: #111827; }
    .totals-total-amount { color: #0d9488 !important; }

    /* ── Progress Columns ── */
    .progress-cell { font-size: 11px; }
    .progress-bar-wrap { background: #e5e7eb; border-radius: 4px; height: 5px; margin-top: 3px; width: 80px; }
    .progress-bar-fill { background: #0d9488; border-radius: 4px; height: 5px; }

    /* ── Notes + Footer ── */
    .footer-section { display: flex; justify-content: space-between; align-items: flex-start; margin-top: 8px; gap: 20px; }
    .notes-box { flex: 1; }
    .notes-box .notes-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.8px; color: #9ca3af; margin-bottom: 6px; font-weight: 700; }
    .notes-box p { font-size: 12px; color: #6b7280; line-height: 1.6; }
    .stamp-box { text-align: right; }
    .stamp { display: inline-block; border: 2px dashed #0d9488; border-radius: 8px; padding: 10px 20px; }
    .stamp .stamp-label { font-size: 10px; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 24px; }
    .stamp .stamp-value { font-size: 12px; font-weight: 600; color: #0d9488; }
    .page-footer {
      margin-top: 36px; padding-top: 14px; border-top: 1px solid #e5e7eb;
      display: flex; justify-content: space-between;
      font-size: 11px; color: #9ca3af;
    }
    .terms {
      background: #fafafa; border-radius: 6px; padding: 12px 16px;
      margin-top: 20px; font-size: 11px; color: #6b7280; line-height: 1.8;
    }
    .terms-title { font-weight: 700; color: #374151; margin-bottom: 4px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; }
  </style>
</head>
<body>
  <div class="page">

    <!-- Header -->
    <div class="header">
      <div class="brand">
        <h1>{{organizationName}}</h1>
        {{#if organizationAddress}}<p>{{organizationAddress}}</p>{{/if}}
        {{#if organizationEmail}}<p>{{organizationEmail}}</p>{{/if}}
      </div>
      <div class="doc-meta">
        <div class="doc-type">Purchase Order</div>
        <div class="po-number">#{{poNumber}}</div>
        <span class="status-chip status-{{status}}">{{status}}</span>
      </div>
    </div>

    <!-- Party Cards -->
    <div class="party-grid">
      <div class="party-card">
        <div class="party-label">Supplier</div>
        <div class="party-name">{{supplierName}}</div>
        {{#if supplierContact}}<div class="party-row"><span>Contact</span><strong>{{supplierContact}}</strong></div>{{/if}}
        {{#if supplierPhone}}<div class="party-row"><span>Phone</span><strong>{{supplierPhone}}</strong></div>{{/if}}
        {{#if supplierEmail}}<div class="party-row"><span>Email</span><strong>{{supplierEmail}}</strong></div>{{/if}}
        {{#if supplierTaxId}}<div class="party-row"><span>Tax ID</span><strong>{{supplierTaxId}}</strong></div>{{/if}}
      </div>
      <div class="party-card">
        <div class="party-label">Delivery / Bill To</div>
        <div class="party-name">{{organizationName}}</div>
        {{#if organizationAddress}}<div class="party-row"><span>Address</span><strong>{{organizationAddress}}</strong></div>{{/if}}
        {{#if createdBy}}<div class="party-row"><span>Raised by</span><strong>{{createdBy}}</strong></div>{{/if}}
      </div>
    </div>

    <!-- Meta Strip -->
    <div class="meta-strip">
      <div class="meta-item">
        <div class="meta-label">PO Date</div>
        <div class="meta-value">{{createdAt}}</div>
      </div>
      {{#if expectedAt}}
      <div class="meta-item">
        <div class="meta-label">Expected Delivery</div>
        <div class="meta-value">{{expectedAt}}</div>
      </div>
      {{/if}}
      {{#if receivedAt}}
      <div class="meta-item">
        <div class="meta-label">Received On</div>
        <div class="meta-value">{{receivedAt}}</div>
      </div>
      {{/if}}
      <div class="meta-item">
        <div class="meta-label">Total Items</div>
        <div class="meta-value">{{itemCount}} line{{#if multipleItems}}s{{/if}}</div>
      </div>
    </div>

    <!-- Line Items -->
    <table>
      <thead>
        <tr>
          <th style="width:5%">#</th>
          <th style="width:38%">Product / Description</th>
          <th>SKU</th>
          <th>Ordered</th>
          <th>Received</th>
          <th>Unit Cost</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        {{#each items}}
        <tr>
          <td>{{this.index}}</td>
          <td>
            <div class="item-name">{{this.name}}</div>
            {{#if this.packInfo}}<div class="item-sku">{{this.packInfo}}</div>{{/if}}
          </td>
          <td>{{this.sku}}</td>
          <td>{{this.quantityOrdered}}</td>
          <td class="progress-cell">
            {{this.quantityReceived}}
            {{#if this.receiveProgress}}
            <div class="progress-bar-wrap">
              <div class="progress-bar-fill" style="width:{{this.receiveProgress}}%"></div>
            </div>
            {{/if}}
          </td>
          <td>{{this.unitCost}}</td>
          <td><strong>{{this.totalCost}}</strong></td>
        </tr>
        {{/each}}
      </tbody>
    </table>

    <!-- Totals -->
    <div class="totals-wrap">
      <div class="totals">
        <div class="totals-row"><span>Subtotal</span><span>{{totalAmount}}</span></div>
        <div class="totals-row"><span><strong>Total Amount</strong></span><span class="totals-total-amount">{{totalAmount}}</span></div>
      </div>
    </div>

    <!-- Footer Section -->
    <div class="footer-section">
      {{#if notes}}
      <div class="notes-box">
        <div class="notes-label">Notes / Reference</div>
        <p>{{notes}}</p>
      </div>
      {{/if}}
      <div class="stamp-box">
        <div class="stamp">
          <div class="stamp-label">Authorised Signature</div>
          <div class="stamp-value">{{organizationName}}</div>
        </div>
      </div>
    </div>

    <!-- Terms -->
    <div class="terms">
      <div class="terms-title">Terms &amp; Conditions</div>
      1. Goods must match the specifications in this purchase order. &nbsp;
      2. Invoice must reference PO number <strong>{{poNumber}}</strong>. &nbsp;
      3. Prices are fixed as agreed — no variation without prior written approval. &nbsp;
      4. Delivery to be completed by the expected date unless otherwise notified.
    </div>

    <div class="page-footer">
      <span>{{organizationName}} &bull; {{organizationEmail}}</span>
      <span>Generated {{generatedAt}}</span>
    </div>

  </div>
</body>
</html>
